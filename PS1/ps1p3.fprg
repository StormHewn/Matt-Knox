<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="PhotonUser"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-31 04:24:01 PM"/>
        <attribute name="created" value="UGhvdG9uVXNlcjtFQzJBTUFaLTA2TEFBTTE7MjAyNi0wOC0zMTswMzo1OTo0NCBQTTszMzAw"/>
        <attribute name="edited" value="UGhvdG9uVXNlcjtFQzJBTUFaLTA2TEFBTTE7MjAyNi0wOC0zMTswNDoyNDowMSBQTTsxOzMzOTQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="width, height" type="Real" array="False" size=""/>
            <output expression="&quot;What is the width of the rectangle?&quot;" newline="True"/>
            <input variable="width"/>
            <output expression="&quot;What is the height of the rectangle?&quot;" newline="True"/>
            <input variable="height"/>
            <declare name="area, perimeter" type="Real" array="False" size=""/>
            <assign variable="area" expression="width*height"/>
            <assign variable="perimeter" expression="(width+height)*2"/>
            <output expression="&quot;The area of the rectangle is &quot; &amp; area &amp; &quot; square units&quot;" newline="True"/>
            <output expression="&quot;The perimeter of the rectangle is &quot; &amp; perimeter &amp; &quot; units&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
