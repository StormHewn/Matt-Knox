<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="PhotonUser"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-31 04:32:10 PM"/>
        <attribute name="created" value="UGhvdG9uVXNlcjtFQzJBTUFaLTA2TEFBTTE7MjAyNi0wOC0zMTswMzozMToxOSBQTTszMjky"/>
        <attribute name="edited" value="UGhvdG9uVXNlcjtFQzJBTUFaLTA2TEFBTTE7MjAyNi0wOC0zMTswNDozMjoxMCBQTTs2OzMzOTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastName" type="String" array="False" size=""/>
            <declare name="creditHours, totalCharge" type="Integer" array="False" size=""/>
            <output expression="&quot;What is the student's last name?&quot;" newline="True"/>
            <input variable="lastName"/>
            <output expression="&quot;How many credit-hours are they taking this semester?&quot;" newline="True"/>
            <input variable="creditHours"/>
            <assign variable="totalCharge" expression="(creditHours*250)+100"/>
            <output expression="&quot;The total cost for this semester for Mr./Ms. &quot; &amp; lastName &amp; &quot; is $&quot; &amp; totalCharge" newline="True"/>
        </body>
    </function>
</flowgorithm>
